# Ansible managed. DO NOT EDIT.

# AmneziaWG configuration for {{ inventory_hostname }}

[Interface]
Address = {{ awg_addresses | join(', ') }}
ListenPort = {{ awg_port }}
PrivateKey = {{ awg_private_key }}
{% if awg_dns is defined and awg_dns %}
DNS = {{ awg_dns }}
{% endif %}
{% if awg_mtu is defined and awg_mtu %}
MTU = {{ awg_mtu }}
{% endif %}
{% if awg_fwmark is defined and awg_fwmark %}
FwMark = {{ awg_fwmark }}
{% endif %}
{% if awg_table is defined and awg_table %}
Table = {{ awg_table }}
{% endif %}
{% if awg_jc | int > 0 %}
Jc = {{ awg_jc }}
{% endif %}
{% if awg_jmin | int > 0 %}
Jmin = {{ awg_jmin }}
{% endif %}
{% if awg_jmax | int > 0 %}
Jmax = {{ awg_jmax }}
{% endif %}
{% if awg_s1 | int > 0 %}
S1 = {{ awg_s1 }}
{% endif %}
{% if awg_s2 | int > 0 %}
S2 = {{ awg_s2 }}
{% endif %}
{% if awg_s3 | int > 0 %}
S3 = {{ awg_s3 }}
{% endif %}
{% if awg_s4 | int > 0 %}
S4 = {{ awg_s4 }}
{% endif %}
{% if awg_h1 | int > 0 or (awg_h1 is string and '-' in awg_h1) %}
H1 = {{ awg_h1 }}
{% endif %}
{% if awg_h2 | int > 0 or (awg_h2 is string and '-' in awg_h2) %}
H2 = {{ awg_h2 }}
{% endif %}
{% if awg_h3 | int > 0 or (awg_h3 is string and '-' in awg_h3) %}
H3 = {{ awg_h3 }}
{% endif %}
{% if awg_h4 | int > 0 or (awg_h4 is string and '-' in awg_h4) %}
H4 = {{ awg_h4 }}
{% endif %}
{% if awg_i1 | int > 0 or (awg_i1 is string and '-' in awg_i1) %}
I1 = {{ awg_i1 }}
{% endif %}
{% if awg_i2 | int > 0 or (awg_i2 is string and '-' in awg_i2) %}
I2 = {{ awg_i2 }}
{% endif %}
{% if awg_i3 | int > 0 or (awg_i3 is string and '-' in awg_i3) %}
I3 = {{ awg_i3 }}
{% endif %}
{% if awg_i4 | int > 0 or (awg_i4 is string and '-' in awg_i4) %}
I4 = {{ awg_i4 }}
{% endif %}
{% if awg_rekey_after is defined and awg_rekey_after %}
RekeyAfterTime = {{ awg_rekey_after }}
{% endif %}
{% if awg_rekey_timeout is defined and awg_rekey_timeout %}
RekeyTimeout = {{ awg_rekey_timeout }}
{% endif %}
{% if awg_reject_after is defined and awg_reject_after %}
RejectAfterTime = {{ awg_reject_after }}
{% endif %}
{% if awg_max_handshake_attempts is defined and awg_max_handshake_attempts %}
MaxHandshakeAttempts = {{ awg_max_handshake_attempts }}
{% endif %}
{% if awg_preup is defined and awg_preup %}
{% for cmd in awg_preup %}
PreUp = {{ cmd }}
{% endfor %}
{% endif %}
{% if awg_postup is defined and awg_postup %}
{% for cmd in awg_postup %}
PostUp = {{ cmd }}
{% endfor %}
{% endif %}
{% if awg_predown is defined and awg_predown %}
{% for cmd in awg_predown %}
PreDown = {{ cmd }}
{% endfor %}
{% endif %}
{% if awg_postdown is defined and awg_postdown %}
{% for cmd in awg_postdown %}
PostDown = {{ cmd }}
{% endfor %}
{% endif %}

RandomTrailers = {{ awg_random_trailers | default(0) }}
DisableCookies = {{ awg_disable_cookies | default(0) }}
{% if awg_header_protection_key is defined and awg_header_protection_key %}
HeaderProtectionKey = {{ awg_header_protection_key }}
{% endif %}

{% macro peer(peer)%}
[Peer]
# {{ peer_name }} (unmanaged)
PublicKey = {{ peer.public_key }}
{% if peer.preshared_key is defined and peer.preshared_key %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}
AllowedIPs = {{ peer.allowed_ips }}
{% if peer.endpoint is defined and peer.endpoint %}
Endpoint = {{ peer.endpoint }}:{{ peer.port | default(awg_port) }}
{% endif %}
{% if peer.persistent_keepalive is defined and peer.persistent_keepalive %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}
{% endmacro %}

# Role's managed peers section
{% for host in ansible_play_hosts if host != inventory_hostname and (not awg_as_spoke | default(false)) %}
{% set peer = {
    'public_key': hostvars[host].awg_public_key,
    'preshared_key': hostvars[host].awg_preshared_key,
    'allowed_ips': hostvars[host].awg_allowed_ips,
    'endpoint': hostvars[host].awg_endpoint | default(hostvars[host].ansible_host),
    'port': hostvars[host].awg_port | default(awg_port),
    'persistent_keepalive': hostvars[host].awg_persistent_keepalive | default(awg_persistent_keepalive),
} %}
{{ peer(peer) }}
{% endfor %}
# End of managed peers section

# Unmanaged peers section
{% if awg_unmanaged_peers is defined and awg_unmanaged_peers | length > 0 %}
{% for peer_name in awg_unmanaged_peers %}
{% set peer = awg_unmanaged_peers[peer_name] %}
{{ peer(peer) }}
{% endfor %}
{% endif %}
# End of unmanaged peers section